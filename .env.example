DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: register commands instantly in a development server instead of globally.
DISCORD_GUILD_ID=
# Optional locally: auto-detects an existing aotw.sqlite or album-of-the-week.sqlite in ./data.
# On Railway: attach a volume; omit this to use its mount path, or point to the existing file inside it.
# DATABASE_PATH=./data/album-of-the-week.sqlite
PORT=3000
