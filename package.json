{
  "name": "album-of-the-week",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun --bun tsc -p tsconfig.build.json",
    "start": "bun dist/index.js",
    "register": "bun src/register.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test ./test",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "cron-parser": "^5.4.0",
    "discord.js": "^14.22.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "@types/bun": "^1.4.2"
  },
  "packageManager": "bun@1.4.3"
}
